# Copy to .env.local (git-ignored) and paste your TMDB API Read Access Token.
VITE_TMDB_TOKEN=

# Or point the app at a proxy that adds the token server-side (keeps it out of the app):
# VITE_TMDB_BASE_URL=https://your-proxy.example/3

# Previews and tests only: run on the built-in sample data instead of TMDB.
# VITE_SAMPLE_DATA=true
